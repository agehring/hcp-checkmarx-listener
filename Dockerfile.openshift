# OpenShift-compatible Dockerfile using Chainguard Images
# Build stage
FROM cgr.dev/chainguard/go:1.23 AS builder

# Set working directory
WORKDIR /app

# Copy go mod files
COPY go.mod go.sum ./

# Download dependencies
RUN go mod download

# Copy source code
COPY . .

# Build the application for Linux with static linking
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build \
    -a -installsuffix cgo -ldflags '-extldflags "-static"' \
    -o main ./cmd

# Final stage - using Chainguard glibc-dynamic for OpenShift compatibility (version pinned)
FROM cgr.dev/chainguard/glibc-dynamic:20241219

# Add OpenShift-specific labels
LABEL name="hcp-checkmarx-listener" \
      vendor="Checkmarx" \
      version="1.0" \
      release="1" \
      summary="HCP Terraform Checkmarx One Integration" \
      description="OpenShift-optimized run task integration between HCP Terraform and Checkmarx One for IaC scanning" \
      io.k8s.description="HCP Terraform integration with Checkmarx One for Infrastructure as Code security scanning" \
      io.k8s.display-name="HCP Terraform Checkmarx Integration" \
      io.openshift.expose-services="8080:http" \
      io.openshift.tags="terraform,checkmarx,security,iac,scanning" \
      io.openshift.min-memory="256Mi" \
      io.openshift.min-cpu="100m"

# Copy the binary from builder stage
COPY --from=builder /app/main /app/main

# Expose port 8080 (OpenShift default)
EXPOSE 8080

# Set environment variables
ENV GIN_MODE=release \
    PORT=8080

# Use the nonroot user that works with OpenShift's arbitrary UID assignment
USER 65532

# Run the application
ENTRYPOINT ["/app/main"]