# Ultra-minimal build to eliminate all system vulnerabilities
# Build stage
FROM golang:1.23-alpine AS builder

# Set working directory
WORKDIR /app

# Copy go mod files first for better caching
COPY go.mod go.sum ./

# Download dependencies (no system packages needed for pure Go)
RUN go mod download

# Copy source code
COPY . .

# Build completely static binary with no system dependencies
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build \
    -a -installsuffix cgo \
    -ldflags '-extldflags "-static" -s -w' \
    -trimpath \
    -o main ./cmd

# Final stage - completely empty scratch image
FROM scratch

# Copy only the binary and certificates
COPY --from=builder /app/main /main
COPY --from=builder /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/

# Expose port 8080
EXPOSE 8080

# Set environment variables
ENV GIN_MODE=release
ENV PORT=8080

# Run the application
ENTRYPOINT ["/main"]